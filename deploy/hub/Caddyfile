# The mirror in Iran: Caddy gets the certificate for HUB_DOMAIN (a DNS-only record, so it resolves to this server and
# not to a CDN that may be out of reach from inside Iran).
{$HUB_DOMAIN} {
	encode gzip
	request_body {
		max_size 20MB
	}
	reverse_proxy hub:8090 {
		# the service limits registrations per address; this is the address, and a client can't set it
		header_up X-Real-IP {remote_host}
		transport http {
			# the Bale relay's long polls wait up to 50 seconds
			read_timeout 75s
		}
	}
	header -Server
}
