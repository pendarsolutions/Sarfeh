[Unit]
Description=Sarfeh: count the website's visits from its access log and rewrite the owner's panel
After=docker.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/sarfeh
ExecStart=/usr/bin/python3 /home/ubuntu/sarfeh/stats.py --dir /home/ubuntu/sarfeh
TimeoutStartSec=5min
Nice=10
